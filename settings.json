{
    // Размер окна игры в пикселях
    "WindowSize": {
        "Width": 0,  // ширина окна; 0 — подобрать автоматически по размеру экрана
        "Hight": 0   // высота окна; 0 — подобрать автоматически (окно будет квадратным)
    },
    // Настройки ботов
    "Bot": {
        "IsWhiteBot": false,   // true — белыми играет бот, false — человек
        "IsBlackBot": true,    // true — чёрными играет бот, false — человек
        "WhiteBotLevel": 0,    // уровень белого бота: глубина поиска минимакса (в ходах)
        "BlackBotLevel": 5,    // уровень чёрного бота: глубина поиска минимакса (в ходах)
        "BotScoringType": "NumberAndPotential", // оценка позиции: "Number" — только число шашек и дамок,
        // "NumberAndPotential" — ещё и бонус за продвижение шашек к дамочному полю
        "BotDelayMS": 0,       // задержка перед ходом бота, мс (чтобы успеть увидеть ход)
        "NoRandom": false,     // true — генератор случайных чисел с фиксированным seed: бот играет одинаково от партии к партии;
        // false — seed от текущего времени, среди равноценных ходов выбор случайный
        "Optimization": "O1"   // "O0" — полный перебор, "O1" — с альфа-бета отсечением (быстрее при той же глубине)
    },
    // Общие настройки партии
    "Game": {
        "MaxNumTurns": 120     // максимальное число ходов; если достигнуто — объявляется ничья
    }
}